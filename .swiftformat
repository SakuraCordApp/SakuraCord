--swiftversion 6.4
--indent 4
--commas inline
--stripunusedargs closure-only
--disable blankLinesAtEndOfScope,blankLinesBetweenScopes,braces,conditionalAssignment,contentBuilder,docComments,enumNamespaces,hoistAwait,hoistPatternLet,hoistTry,indent,modifierOrder,nestedIf,noForceTryInTests,noForceUnwrapInTests,numberFormatting,opaqueGenericParameters,preferKeyPath,redundantMemberwiseInit,redundantNilInit,redundantParens,redundantReturn,redundantSelf,redundantThrows,redundantType,redundantVariable,repeatedGuard,sortImports,swiftTestingTestCaseNames,trailingCommas,wrapArguments,wrapFunctionBodies,wrapIfExpressionBodies,wrapIfStatementBodies,wrapLoopBodies,wrapMultilineStatementBraces,wrapPropertyBodies
