{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "locations",
    "cause",
    "suggestedFix",
    "suggestedTest",
    "confidence",
    "fixable",
    "triage",
    "fixCommit",
    "classificationReason",
    "fixPullRequest",
    "findings"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "description": "Two or three sentences for the reporter and maintainers."
    },
    "locations": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "line",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "cause": {
      "type": "string"
    },
    "suggestedFix": {
      "type": "string"
    },
    "suggestedTest": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "fixable": {
      "type": "boolean"
    },
    "triage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "area",
        "priority",
        "title",
        "summary",
        "duplicateOf",
        "duplicateConfidence",
        "duplicateReason",
        "needsInformation",
        "questions"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "bug",
            "feature"
          ]
        },
        "area": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 90
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "duplicateOf": {
          "type": [
            "integer",
            "null"
          ]
        },
        "duplicateConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "duplicateReason": {
          "type": "string",
          "maxLength": 400
        },
        "needsInformation": {
          "type": "boolean"
        },
        "questions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "fixCommit": {
      "type": [
        "string",
        "null"
      ],
      "description": "Full 40-character commit SHA that fixes precisely this report, only after inspecting its diff and the relevant release source; otherwise null."
    },
    "fixPullRequest": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Number of an open pull request from openPullRequests that fixes or implements precisely this report, only after reading its diff; otherwise null."
    },
    "classificationReason": {
      "type": "string",
      "maxLength": 500,
      "description": "Why this is a bug or feature, especially if the reporter chose the wrong category."
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fix",
        "pullRequest",
        "duplicate",
        "kind",
        "existingFeature"
      ],
      "description": "Each status-changing finding rated on its own evidence, separately from the overall confidence. Rate high only when you verified it in code, diffs, or candidate reports; rate low when it does not apply.",
      "properties": {
        "fix": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "fixCommit fixes precisely this report."
        },
        "pullRequest": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "fixPullRequest fixes or implements precisely this report."
        },
        "duplicate": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "triage.duplicateOf is the same underlying problem or request."
        },
        "kind": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "triage.kind is right, whichever category the reporter chose."
        },
        "existingFeature": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "This suggestion asks for something SakuraCord already does, and your question names where."
        }
      }
    }
  }
}
